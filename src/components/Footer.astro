---
import { SITE } from '../consts';
import { withBase } from '../utils';
import Obfuscated from './Obfuscated.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container wide footer-inner">
    <div>
      <p class="footer-name">{SITE.fullName}</p>
      <p class="small muted">{SITE.sponsor}</p>
    </div>
    <div class="footer-links small">
      <p>
        Contact the steering committee: <Obfuscated email={SITE.contactEmail} />
      </p>
      <p class="muted">
        &copy; {year} ICPC Steering Committee.
        <a href={SITE.github}>Site source on GitHub</a> · Built with <a href="https://astro.build">Astro</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--space-lg);
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .footer-inner p { margin: 0 0 0.25rem; }
  .footer-name { font-family: var(--font-display); font-weight: 700; }
  .footer-links { text-align: right; }
  @media (max-width: 640px) { .footer-links { text-align: left; } }
</style>
